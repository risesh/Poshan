# Copy this file to .env.local and fill in real values. .env.local is
# gitignored by default.

# Supabase project dashboard -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay dashboard -> Settings -> API Keys. Only needed for online
# payment at checkout — Cash on Delivery works without these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
