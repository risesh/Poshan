# Copy this file to .env.local and fill in real values. .env.local is
# gitignored by default.

# The site's real production domain, no trailing slash. Used for
# metadataBase (canonical URLs, sitemap entries, OG image URLs, JSON-LD).
# Placeholder until a real domain is registered — see SEO-ROADMAP.md §1.1.
NEXT_PUBLIC_SITE_URL=https://www.poshan.example

# Supabase project dashboard -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay dashboard -> Settings -> API Keys. Only needed for online
# payment at checkout — Cash on Delivery works without these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials. Needs the Places
# API (New) enabled and billing attached. Server-side only — restrict the
# key by API, not by HTTP referrer (referrer restriction only works for
# browser-side calls, and these are proxied through our own route handlers).
GOOGLE_PLACES_API_KEY=

# Resend dashboard -> API Keys. Used to email admins (lib/admin.ts's
# ADMIN_EMAILS) when a new order comes in — see lib/notify-admins.ts.
# Optional: if unset, new-order emails are silently skipped (checkout
# itself never depends on this). RESEND_FROM_EMAIL defaults to Resend's
# sandbox sender (onboarding@resend.dev), which works with zero DNS setup;
# verifying the real domain in Resend is a later reliability improvement,
# not required to get started.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# A standing test-admin account (test-admin@poshan.test) for local/agent-
# driven testing of admin-only features, granted the same RLS access as a
# real admin — see supabase/migrations/0012_test_admin_account.sql and
# lib/admin.ts's ADMIN_EMAILS. Real credentials live only in .env.local,
# never committed here.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
