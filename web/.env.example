# Copy this file to .env.local and fill in real values. .env.local is
# gitignored by default.

# Supabase project dashboard -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay dashboard -> Settings -> API Keys. Only needed for online
# payment at checkout — Cash on Delivery works without these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials. Needs the Places
# API (New) enabled and billing attached. Server-side only — restrict the
# key by API, not by HTTP referrer (referrer restriction only works for
# browser-side calls, and these are proxied through our own route handlers).
GOOGLE_PLACES_API_KEY=
